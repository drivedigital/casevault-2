{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "casevault-2",
  "account_id": "2eb39046954b68cb7fb92ce98a6679b4",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "casevault-2"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "114ab4665b034d38be31666f435c0ce8",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/casevault2"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "legal-evidence-arena"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "LEGACY_EVIDENCE",
      "id": "d707525cc924472aadf3bd3eeccec3db"
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://lrollxodgqswpylzulpu.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_cW2J6APjBPQkJArG41ztCQ_Tnyz-ZAV",
    "ALLOWED_LOGIN_EMAIL": "dgeorgenyc@gmail.com",
    "WORKSPACE_ID": "b37e40d6-4746-490c-9b73-ea46e15e2b01"
  },
  "observability": {
    "enabled": true
  }
}
